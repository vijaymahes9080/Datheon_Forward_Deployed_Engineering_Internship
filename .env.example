# AegisAI Enterprise Gateway - Environment Configuration

# Server & Runtime
AEGIS_HOST=0.0.0.0
AEGIS_PORT=8000
AEGIS_ENVIRONMENT=production
AEGIS_LOG_LEVEL=INFO
AEGIS_ALLOWED_HOSTS=["*"]

# Security & Multi-Tenancy
AEGIS_SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex
AEGIS_API_KEY_HEADER=X-Aegis-API-Key
AEGIS_TOKEN_EXPIRATION_MINUTES=60
AEGIS_APPROVAL_TTL_SECONDS=900

# Storage & Persistence
AEGIS_DATABASE_URL=sqlite:///./storage/aegis.db
AEGIS_CHROMA_PERSIST_DIR=./storage/chroma_db
AEGIS_STORAGE_DIR=./storage/documents

# Embeddings & Retrieval
AEGIS_EMBEDDING_PROVIDER=mock
AEGIS_EMBEDDING_MODEL=all-MiniLM-L6-v2
AEGIS_EMBEDDING_DIMENSION=384
AEGIS_TOP_K_RETRIEVAL=5
AEGIS_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
AEGIS_SIMILARITY_THRESHOLD=0.20

# LLM Generation
AEGIS_LLM_PROVIDER=mock
AEGIS_LLM_MODEL=llama3:8b
AEGIS_OLLAMA_BASE_URL=http://localhost:11434

# Ingestion Pipeline
AEGIS_CHUNK_SIZE=512
AEGIS_CHUNK_OVERLAP=64
AEGIS_MAX_CONCURRENT_INGESTIONS=4
